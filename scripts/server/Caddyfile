# NIZAM Caddyfile — place at /etc/caddy/Caddyfile on the VPS.
# Replace YOUR_DOMAIN with your actual domain (e.g. nizam.seif.dev).
# Caddy handles TLS automatically via Let's Encrypt.

YOUR_DOMAIN {
    reverse_proxy localhost:3000
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # API routes go to the server
    handle /api/* {
        reverse_proxy localhost:3000
    }

    # Static SPA files (if serving the built frontend from the same box)
    handle {
        root * /opt/nizam/dist
        try_files {path} /index.html
        file_server
    }
}
