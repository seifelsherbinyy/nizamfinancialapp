# NIZAM — copy to .env.local and fill. NEVER commit the filled file.
# Google OAuth (Desktop/Web client for Drive-as-database). Scope: drive.file
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-browser-api-key
# Drive folder that holds the NIZAM database file (nizam_db.json)
VITE_NIZAM_DRIVE_FOLDER_ID=
# money base unit: milliunits (YNAB convention, 1 EGP = 1000)
VITE_MONEY_BASE=milliunits
VITE_DEFAULT_CURRENCY=EGP
