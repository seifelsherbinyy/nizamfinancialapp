# NIZAM — copy to .env.local and fill. NEVER commit the filled file.
# These are the ONLY environment keys the application reads.

# Google OAuth WEB client id (Drive-as-database sign-in). Scope used: drive.file ONLY.
# Read by: src/lib/drive/oauth.ts — required for the "Connect Google Drive" button.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Browser API key with the Drive API + Picker API enabled.
# Read by: src/lib/drive/picker.ts — required for the one-time ledger import via Picker.
VITE_GOOGLE_API_KEY=your-browser-api-key

# Optional: an existing Drive folder id to hold nizam_db.json.
# Read by: src/state/store.ts — when empty the app creates/finds a "NIZAM" folder itself.
VITE_NIZAM_DRIVE_FOLDER_ID=
