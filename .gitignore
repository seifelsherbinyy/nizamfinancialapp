# deps / build
node_modules/
dist/
.vite/
coverage/
# env / secrets — NEVER commit
.env
.env.local
*.client_secret.json
token.json
# local personal data — never commit real ledgers
data/ledgers/*.json
data/ledgers/*.csv
!data/ledgers/*.example.json
!data/ledgers/.gitkeep
# os / editor
.DS_Store
Thumbs.db
.idea/
*.log
# continuation analysis + build session inputs (tooling, not app code)
outputs/
Execute and build.md
# loop scratch (the ledger itself IS committed)
.loop/tmp/
# raw third-party API dumps captured by research tooling. The curated report, evidence matrix and
# shortlist ARE committed; the raw responses are regenerable by the scripts in the same folder and
# carry vendor prose that the generic-only check (AC11) forbids in a tracked file.
docs/research/**/_raw/
# --- local secrets (never commit) ---
.secrets/
.env.*.local
*client_secret*.json
secretsgoogle*.txt
