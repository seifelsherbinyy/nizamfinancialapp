this bot only:

    if not dedup.claim(bot_id, update_id):
        continue
    offset = dedup.max_seen(bot_id) + 1

WHY THE OFFSET MATTERS. A shared maximum across two independent sequences tells
the poller to resume past updates it has never seen, so the fix is incomplete
without it.

--- 3.4 TESTS TO ADD: NIZAM__system/relay/tests/test_dedup.py

Add these to the existing test module. The first is the one that matters: it is
the test that fails on the current code.

```python
def test_two_bots_emitting_the_same_identifier_are_both_processed(tmp_path):
    """The collision this change exists to fix.

    On the previous key this fails: the second claim is refused as a duplicate
    of an unrelated update, and one bot goes quiet.
    """
    state = DedupState(str(tmp_path / "dedup-state"))
    assert state.claim("bot-a", 1) is True
    assert state.claim("bot-b", 1) is True


def test_the_same_pair_twice_is_a_duplicate_and_not_an_error(tmp_path):
    state = DedupState(str(tmp_path / "dedup-state"))
    assert state.claim("bot-a", 7) is True
    assert state.claim("bot-a", 7) is False


def test_one_bots_traffic_cannot_evict_another_bots_window(tmp_path):
    """The per-bot bound, asserted rather than assumed."""
    state = DedupState(str(tmp_path / "dedup-state"), window_per_bot=4)
    assert state.claim("quiet", 1) is True
    for identifier in range(100, 120):
        state.claim("chatty", identifier)
    assert state.claim("quiet", 1) is False


def test_resumption_offset_is_per_bot(tmp_path):
    state = DedupState(str(tmp_path / "dedup-state"))
    state.claim("bot-a", 500)
    state.claim("bot-b", 3)
    assert state.max_seen("bot-b") == 3


def test_state_survives_a_reload_through_the_atomic_replace(tmp_path):
    path = str(tmp_path / "dedup-state")
    first = DedupState(path)
    assert first.claim("bot-a", 11) is True
    second = DedupState(path)
    assert second.claim("bot-a", 11) is False


def test_a_legacy_identifier_is_not_claimable_after_the_upgrade(tmp_path):
    """The migration direction, asserted. A replay across the upgrade is refused."""
    path = tmp_path / "dedup-state"
    path.write_text("[41, 42]", encoding="utf-8")
    state = DedupState(str(path))
    assert state._claimed_by_legacy(42) is True


def test_a_missing_bot_identifier_is_refused(tmp_path):
    state = DedupState(str(tmp_path / "dedup-state"))
    try:
        state.claim("", 1)
    except ValueError:
        return
    raise AssertionError("an empty bot identifier must be refused, not defaulted")
```

