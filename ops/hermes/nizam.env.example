# NIZAM internal Hermes profile protected environment template.
# This profile is invoked by the ingress coordinator, not as a standalone gateway.
# No platform credentials required; those live in the ingress profile only.
HERMES_HOME=<NIZAM_HERMES_HOME>
OPENROUTER_API_KEY=<OR_KEY_LIFE>
NIZAM_KILL_ALL=<NIZAM_KILL_ALL>
